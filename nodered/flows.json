    "type": "function",
    "z": "dk_tab",
    "x": 380,
    "y": 620,
    "name": "query ringkasan",
    "func": "// Total kantuk hari ini (sejak 00.00) dan 10 kejadian terakhir\nconst awal = new Date();\nawal.setHours(0, 0, 0, 0);\nreturn [{payload: {jenis: 'alarm', diterima: {$gte: awal}}},\n        {payload: {}, sort: {diterima: -1}, limit: 10}];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",

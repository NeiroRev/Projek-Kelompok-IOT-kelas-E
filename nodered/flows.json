  {
    "id": "dk_f_status",
    "type": "function",
    "z": "dk_tab",
    "x": 760,
    "y": 260,
    "name": "status perangkat",
    "func": "// Gabungkan status MQTT (retain + Last Will), telemetri, dan watchdog 5 s\nconst s = context.get('s') || {online: false, kamera: false, rssi: null, alarm: false, wajib: false, waktu: '-'};\nif (msg.topic === 'kelompok8/deteksi_kantuk/status') {\n    s.online = msg.payload === 'online';\n} else if (msg.topic === 'watchdog') {\n    s.online = false;\n} else {\n    const p = msg.payload;\n    s.online = true;\n    s.kamera = !!p.kamera;\n    s.rssi = p.rssi;\n    s.alarm = !!p.alarm;\n    s.wajib = !!p.wajib_istirahat;\n    s.waktu = new Date().toLocaleTimeString('id-ID');\n}\ncontext.set('s', s);\nreturn {payload: Object.assign({}, s)};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "dk_ui_status"
      ]
    ]
  },
  {
    "id": "dk_ui_status",
    "type": "ui_template",
    "z": "dk_tab",
    "x": 960,
    "y": 260,
    "group": "dk_g_status",
    "order": 1,
    "width": "6",
    "height": "5",
    "name": "Status perangkat",
    "format": "<div ng-if=\"msg.payload\">\n  <div style=\"font-size:1.3em;font-weight:bold\" ng-style=\"{color: msg.payload.online ? '#2e7d32' : '#c62828'}\">\n    &#9679; Perangkat {{msg.payload.online ? 'ONLINE' : 'OFFLINE'}}\n    <span ng-if=\"msg.payload.online && !msg.payload.kamera\" style=\"color:#ef6c00\"> &middot; kamera/laptop TERPUTUS</span>\n  </div>\n  <div ng-if=\"msg.payload.online\">RSSI {{msg.payload.rssi}} dBm &middot; update terakhir {{msg.payload.waktu}}</div>\n  <div ng-if=\"!msg.payload.online\">Alarm lokal di alat tetap bekerja tanpa internet.</div>\n  <div ng-if=\"msg.payload.alarm\" style=\"background:#c62828;color:#fff;padding:8px;margin-top:8px;font-weight:bold\">\n    ALARM AKTIF &mdash; pengemudi harus menekan tombol di alat</div>\n  <div ng-if=\"msg.payload.wajib\" style=\"background:#7f0000;color:#fff;padding:12px;margin-top:8px;font-size:1.4em;font-weight:bold;text-align:center\">\n    WAJIB ISTIRAHAT<br><small>2 alarm dalam 10 menit</small></div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "wires": [
      []
    ]
  },

  {
    "id": "dk_f_pecah",
    "type": "function",
    "z": "dk_tab",
    "x": 380,
    "y": 160,
    "name": "pecah telemetri",
    "func": "// Telemetri 1 Hz dari ESP32 -> widget. Field laptop bernilai null bila kamera/laptop terputus.\nconst p = msg.payload;\nconst SARAN = {SEGAR: 'Kondisi baik, tetap fokus', WASPADA: 'Mulai lelah, minum air dan buka jendela',\n               LELAH: 'Disarankan istirahat 15 menit', BAHAYA: 'Segera menepi dan istirahat', '-': 'Menunggu kalibrasi'};\nconst out = [null, null, null, null, null, null, null];\nconst ada = (v) => v !== null && v !== undefined;\n\nif (p.kamera && ada(p.skor)) out[0] = {payload: p.skor};\nout[1] = {payload: p.kamera ? (p.level || '-') : 'kamera/laptop terputus'};\nout[2] = {payload: p.kamera ? (SARAN[p.level] || '-') : '-'};\nif (ada(p.ambang)) {\n    const kal = {0: ' · sedang kalibrasi', 1: '', 2: ' · kalibrasi gagal'}[p.kalibrasi] || '';\n    const base = ada(p.baseline) ? p.baseline.toFixed(3) : '-';\n    out[3] = {payload: `${p.ambang.toFixed(3)} (baseline ${base})${kal}`};\n}\nif (ada(p.ear)) out[4] = [{topic: 'EAR', payload: p.ear}, {topic: 'Ambang', payload: p.ambang}];\nif (ada(p.skor)) out[5] = [{topic: 'Skor', payload: p.skor}, {topic: 'PERCLOS (%)', payload: p.perclos}];\nout[6] = {payload: p.total_kantuk};\nreturn out;",
    "outputs": 7,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "dk_ui_gauge"
      ],
      [
        "dk_ui_level"
      ],
      [
        "dk_ui_saran"
      ],
      [
        "dk_ui_ambang"
      ],
      [
        "dk_ui_chart_ear"
      ],
      [
        "dk_ui_chart_skor"
      ],
      [
        "dk_ui_total_alat"
      ]
    ]
  },
